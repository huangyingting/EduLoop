# Local development (path is relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
EDULOOP_DATABASE_PROVIDER="sqlite"
# Production requires the exact immutable release ID (1-128 safe token characters).
APP_VERSION="development"

# Auth.js uses an encrypted JWT cookie for email/password and social sessions;
# the same secret keys domain-separated, window-scoped rate-limit pseudonyms.
# Generate a production secret with: npx auth secret
# AUTH_SECRET="replace-with-at-least-32-random-characters"
# AUTH_URL="http://localhost:3000"

# Number of trusted reverse proxies that append to X-Forwarded-For. Production
# defaults to one; set the exact chain depth when a CDN and ingress are both used.
# TRUSTED_PROXY_HOPS="1"

# Required in production for the public legal pages.
# LEGAL_ENTITY_NAME="Your legal entity"
# LEGAL_CONTACT_EMAIL="privacy@example.com"
# LEGAL_JURISDICTION="Your governing law and venue"

# Production email verification and password recovery use Resend. Verify the sender domain first.
# RESEND_API_KEY="re_..."
# AUTH_EMAIL_FROM="EduLoop <accounts@example.com>"

# Optional social providers. A button appears only when both values are set.
# Callback: {AUTH_URL}/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Callback: {AUTH_URL}/api/auth/callback/microsoft-entra-id
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# Callback: {AUTH_URL}/api/auth/callback/facebook
# AUTH_FACEBOOK_ID=""
# AUTH_FACEBOOK_SECRET=""
# FACEBOOK_GRAPH_API_VERSION="v23.0"

# Production uses prisma/postgresql/schema.prisma instead:
# Remote production hosts require authenticated TLS; loopback sidecars are exempt.
# Size connection_limit so replicas times this value leaves database capacity
# for migrations and operators. Timeouts are seconds and must remain nonzero.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/eduloop?schema=public&sslmode=require&connection_limit=8&pool_timeout=10&connect_timeout=5"
# EDULOOP_DATABASE_PROVIDER="postgresql"
