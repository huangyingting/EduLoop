FROM node:26.9.0-alpine@sha256:dbaa92e5758cbbcf85d65d5403fdb530fe3442cbe8c6dbfb7ef23365450d5070 AS operations
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
COPY scripts/verify-install-scripts.mjs ./scripts/
RUN npm ci --include=dev && npm run dependencies:activate && apk add --no-cache postgresql-client
COPY . .
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build npm run db:generate:postgres
ENV NODE_ENV=production
ENV EDULOOP_DATABASE_PROVIDER=postgresql
ENV NEXT_TELEMETRY_DISABLED=1
USER node
CMD ["sh"]
