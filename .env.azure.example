# Copy to .env.azure.local and replace every placeholder before deployment.
# cp .env.azure.example .env.azure.local

# AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_LOCATION="southeastasia"
AZURE_RESOURCE_GROUP="eduloop-prod-sea"
AZURE_CONTAINER_APP_NAME="eduloop"
AZURE_CONTAINER_ENV_NAME="eduloop-sea"
AZURE_MIN_REPLICAS="0"
AZURE_MAX_REPLICAS="2"
AZURE_LOGS_DESTINATION="none"
AZURE_SEED_CATALOG="1"

# PostgreSQL and Auth.js secrets are generated and persisted in Key Vault.
# Set these only when adopting existing resources whose current values must be preserved.
# AZURE_POSTGRES_ADMIN_PASSWORD=""
# AZURE_POSTGRES_APP_PASSWORD=""
# AZURE_AUTH_SECRET=""

AZURE_RESEND_API_KEY="re_replace_with_a_real_key"
AZURE_AUTH_EMAIL_FROM="EduLoop <accounts@example.com>"
AZURE_LEGAL_ENTITY_NAME="Replace with your legal entity"
AZURE_LEGAL_CONTACT_EMAIL="privacy@example.com"
AZURE_LEGAL_JURISDICTION="Replace with your governing law and venue"
