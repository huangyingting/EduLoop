FROM node:26.7.0-alpine@sha256:aadf416b2cdce311a8811ba3f0608a61b77dbf997500e2eafe781b51f6a0b019 AS operations
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --include=dev && apk add --no-cache postgresql-client
COPY . .
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build npm run db:generate:postgres
ENV NODE_ENV=production
ENV EDULOOP_DATABASE_PROVIDER=postgresql
ENV NEXT_TELEMETRY_DISABLED=1
USER node
CMD ["sh"]
