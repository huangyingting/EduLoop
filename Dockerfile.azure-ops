FROM node:24.18.1-alpine@sha256:f70403e87646dc51b45295f4b8b70cdad0b63d2297c4c9899119b03f7af7a6b3 AS operations
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --include=dev && apk add --no-cache postgresql-client
COPY . .
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build npm run db:generate:postgres
ENV NODE_ENV=production
ENV EDULOOP_DATABASE_PROVIDER=postgresql
ENV NEXT_TELEMETRY_DISABLED=1
USER node
CMD ["sh"]
